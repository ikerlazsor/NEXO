EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key


# Obligatoria para mapas en APK/standalone Android (Maps SDK for Android).
# En EAS: eas secret:create --name GOOGLE_MAPS_API_KEY --value "AIza..."
# GOOGLE_MAPS_API_KEY=AIza...

# Opcional: ampliar búsquedas del feed con IA (Edge Function expand-search-query
# con secret OPENAI_API_KEY, o esta clave en cliente). Sin esto, el buscador
# semántico local sigue funcionando gratis.
# EXPO_PUBLIC_OPENAI_API_KEY=sk-...
