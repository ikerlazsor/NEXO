EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key


# Opcional: activa el mapa nativo en Android. Sin clave, la app conserva la
# búsqueda de direcciones y el resto de funciones de ubicación sin mapa incrustado.
# En EAS: eas secret:create --name GOOGLE_MAPS_API_KEY --value "AIza..."
# GOOGLE_MAPS_API_KEY=AIza...

# Solo después de controlar el dominio y publicar apple-app-site-association /
# assetlinks.json. Sin esto, compartir usa el enlace seguro nexo://.
# EXPO_PUBLIC_SHARE_HOST=app.tudominio.com

# Las búsquedas se amplían localmente y no requieren servicios ni claves de IA.

# Login Google (cliente OAuth tipo Web; el mismo Client ID que pegas en Supabase).
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=123456789-xxxx.apps.googleusercontent.com
# Cliente OAuth tipo iOS (bundle com.ikerlazsor.nexo). Necesario para el build nativo.
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=123456789-yyyy.apps.googleusercontent.com
