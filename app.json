{
  "expo": {
    "name": "NEXO",
    "slug": "nexo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nexo",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/nexo-splash-full.png",
      "resizeMode": "contain",
      "backgroundColor": "#E2EBF2"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ikerlazsor.nexo",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Nexo usa tu ubicación para calcular la distancia a los planes y mostrarte cómo llegar.",
        "UIBackgroundModes": [
          "remote-notification"
        ]
      },
      "splash": {
        "image": "./assets/images/nexo-splash-full.png",
        "resizeMode": "contain",
        "backgroundColor": "#E2EBF2"
      }
    },
    "android": {
      "package": "com.ikerlazsor.nexo",
      "adaptiveIcon": {
        "backgroundColor": "#E2EBF2",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "splash": {
        "image": "./assets/images/nexo-splash-full.png",
        "resizeMode": "contain",
        "backgroundColor": "#E2EBF2"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.RECORD_AUDIO"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/nexo-splash-full.png",
          "imageWidth": 300,
          "resizeMode": "contain",
          "backgroundColor": "#E2EBF2",
          "dark": {
            "backgroundColor": "#E2EBF2",
            "image": "./assets/images/nexo-splash-full.png"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "Nexo necesita acceso a tus fotos para tu perfil.",
          "cameraPermission": "Nexo necesita acceso a la cámara para tu foto de perfil."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/nexo-logo-ui.png",
          "color": "#4DA6FF",
          "defaultChannel": "default",
          "sounds": []
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Nexo usa tu ubicación para mostrarte planes cerca de ti."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "edde1434-fc73-4e3b-a3c6-cd46fe2f6a8e"
      }
    },
    "owner": "ikerlazsor"
  }
}
