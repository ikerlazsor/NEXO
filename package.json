{
  "name": "nexo",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "packageManager": "npm@11.9.0",
  "scripts": {
    "start": "expo start",
    "postinstall": "patch-package",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "tsc lib/startupControl.ts --outDir .test-dist --module commonjs --target es2022 --lib es2022,dom --strict --skipLibCheck && node --test tests/*.test.cjs",
    "deps:check": "npm audit --omit=dev --audit-level=critical && npx expo install --check",
    "bundle:check": "expo export --platform android --output-dir /tmp/nexo-android-bundle --clear && expo export --platform ios --output-dir /tmp/nexo-ios-bundle --clear",
    "db:test": "supabase test db",
    "update:preview": "eas update --channel preview --platform ios && eas update --channel preview --platform android",
    "update:production": "eas update --channel production --environment production --platform ios && eas update --channel production --environment production --platform android"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-community/netinfo": "11.4.1",
    "@react-native-google-signin/google-signin": "^16.1.4",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.9.14",
    "@react-navigation/native": "^7.1.8",
    "@shopify/flash-list": "2.3.2",
    "@supabase/supabase-js": "^2.104.0",
    "base64-arraybuffer": "^1.0.2",
    "country-state-city": "^3.2.1",
    "expo": "~54.0.37",
    "expo-apple-authentication": "~8.0.8",
    "expo-asset": "~12.0.13",
    "expo-av": "~16.0.8",
    "expo-blur": "~15.0.8",
    "expo-constants": "~18.0.14",
    "expo-crypto": "~15.0.9",
    "expo-device": "~8.0.10",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-manipulator": "~14.0.7",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-localization": "~17.0.9",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-updates": "~29.0.20",
    "expo-video-thumbnails": "~10.0.8",
    "expo-web-browser": "~15.0.11",
    "lottie-react-native": "~7.3.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-maps": "1.20.1",
    "react-native-modal-datetime-picker": "^18.0.0",
    "react-native-pager-view": "6.9.1",
    "react-native-reanimated": "4.1.6",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-share": "^12.3.1",
    "react-native-view-shot": "^5.1.1",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "rive-react-native": "^9.8.3"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.0",
    "@types/react": "~19.1.0",
    "eslint": "^10.8.1",
    "eslint-config-expo": "~10.0.0",
    "patch-package": "^8.0.1",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "3.15.1"
    },
    "@react-native/dev-middleware": {
      "ws": "6.2.6"
    },
    "@supabase/realtime-js": {
      "ws": "8.21.3"
    },
    "js-yaml": "4.3.1",
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.18"
    },
    "nanoid": "3.3.18",
    "postcss": "8.5.26",
    "react-devtools-core": {
      "shell-quote": "1.10.0",
      "ws": "7.5.13"
    },
    "react-native": {
      "ws": "6.2.6"
    }
  },
  "private": true,
  "expo": {
    "install": {
      "exclude": [
        "@shopify/flash-list"
      ]
    }
  }
}
