{
  "name": "nexo",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "packageManager": "npm@11.9.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "tsc lib/startupControl.ts --outDir .test-dist --module commonjs --target es2022 --lib es2022,dom --strict --skipLibCheck && node --test tests/*.test.cjs",
    "deps:check": "npm audit --omit=dev --audit-level=critical && npx expo install --check",
    "bundle:check": "expo export --platform android --output-dir /tmp/nexo-android-bundle --clear && expo export --platform ios --output-dir /tmp/nexo-ios-bundle --clear",
    "db:test": "supabase test db",
    "update:preview": "eas update --channel preview --platform ios && eas update --channel preview --platform android",
    "update:production": "eas update --channel production --environment production --platform ios && eas update --channel production --environment production --platform android"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "3.1.1",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@react-navigation/bottom-tabs": "^7.19.2",
    "@react-navigation/elements": "^2.9.14",
    "@react-navigation/native": "^7.1.8",
    "@shopify/flash-list": "2.3.2",
    "@supabase/supabase-js": "^2.116.0",
    "base64-arraybuffer": "^1.0.2",
    "expo": "~57.0.24",
    "expo-apple-authentication": "~57.0.2",
    "expo-asset": "~57.0.18",
    "expo-av": "~16.0.8",
    "expo-blur": "~57.0.3",
    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.3",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.19",
    "expo-image-picker": "~57.0.19",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.10",
    "expo-localization": "~57.0.2",
    "expo-location": "~57.0.19",
    "expo-notifications": "~57.0.20",
    "expo-router": "~57.0.22",
    "expo-sharing": "~57.0.21",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.23",
    "expo-video-thumbnails": "~57.0.2",
    "expo-web-browser": "~57.0.3",
    "lottie-react-native": "~7.5.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.87.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-maps": "1.29.2",
    "react-native-modal-datetime-picker": "^18.0.0",
    "react-native-pager-view": "9.0.4",
    "react-native-reanimated": "4.6.0",
    "react-native-safe-area-context": "~5.10.0",
    "react-native-screens": "~4.28.0",
    "react-native-share": "^12.3.1",
    "react-native-view-shot": "^5.1.1",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.13.0",
    "rive-react-native": "^9.8.5"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "3.15.1"
    },
    "@react-native/dev-middleware": {
      "ws": "6.2.6"
    },
    "@supabase/realtime-js": {
      "ws": "8.21.3"
    },
    "js-yaml": "4.3.1",
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.18"
    },
    "nanoid": "3.3.18",
    "postcss": "8.5.26",
    "react-devtools-core": {
      "shell-quote": "1.10.0",
      "ws": "7.5.13"
    },
    "react-native": {
      "ws": "6.2.6"
    }
  },
  "private": true,
  "expo": {
    "install": {
      "exclude": [
        "@shopify/flash-list"
      ]
    }
  }
}
